{
    "name": "koh/sylius-auth-md",
    "description": "Serves /auth.md \u2014 agent registration instructions rendered from the installed authentication methods.",
    "type": "sylius-bundle",
    "license": "MIT",
    "keywords": [
        "sylius",
        "auth.md",
        "agent",
        "oauth",
        "discovery"
    ],
    "authors": [
        {
            "name": "Kai Ole Hartwig",
            "email": "mail@ole-hartwig.eu"
        }
    ],
    "homepage": "https://ole-hartwig.eu/open-source/sylius-agent-ready",
    "support": {
        "issues": "https://git.ole-hartwig.eu/ai-ready-platform/platform/sylius-auth-md/-/issues",
        "source": "https://github.com/ole-hartwig/sylius-auth-md"
    },
    "require": {
        "koh/sylius-agent-contracts": "^1.1",
        "php": "^8.5.11",
        "sylius/sylius": "^2.3.0",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/routing": "^7.4 || ^8.0",
        "twig/twig": "^3.30.0"
    },
    "require-dev": {
        "koh/dev-sylius": "^1.0",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.2.16",
        "phpunit/phpunit": "^11.5.56"
    },
    "autoload": {
        "psr-4": {
            "Koh\\SyliusAuthMd\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Koh\\SyliusAuthMd\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://git.ole-hartwig.eu/api/v4/group/1091/-/packages/composer/packages.json",
            "only": [
                "koh/*"
            ]
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
